diff --git a/pkg/sibenchcapture/capture.go b/pkg/sibenchcapture/capture.go
new file mode 100644
index 0000000000..71904c0bb6
--- /dev/null
+++ b/pkg/sibenchcapture/capture.go
@@ -0,0 +1,136 @@
+// Package sibenchcapture records the statement, transaction, lock and row/index
+// mutation facts that SIBench joins with TiKV's read records. It is enabled only
+// when SIBENCH_TIDB_CAPTURE names a new output file; one JSON object per line.
+package sibenchcapture
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/pingcap/tidb/pkg/kv"
+	"github.com/pingcap/tidb/pkg/types"
+)
+
+var (
+	enabled bool
+	mu      sync.Mutex
+	out     *bufio.Writer
+	flushed time.Time
+	tasks   sync.Map // connection ID -> *atomic.Uint64 current statement task ID
+)
+
+func init() {
+	path := os.Getenv("SIBENCH_TIDB_CAPTURE")
+	if path == "" {
+		return
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY|os.O_APPEND, 0o644)
+	if err != nil {
+		panic(fmt.Sprintf("SIBENCH_TIDB_CAPTURE %s: %v", path, err))
+	}
+	out = bufio.NewWriterSize(f, 1<<20)
+	enabled = true
+	go func() {
+		for range time.Tick(100 * time.Millisecond) {
+			mu.Lock()
+			_ = out.Flush()
+			mu.Unlock()
+		}
+	}()
+}
+
+// TaskIDBase offsets this instance's statement task IDs so TiKV records from
+// several TiDB instances stay distinct; 0 when unset.
+func TaskIDBase() uint64 {
+	v, err := strconv.ParseUint(os.Getenv("SIBENCH_TIDB_TASK_BASE"), 10, 64)
+	if err != nil {
+		return 0
+	}
+	return v
+}
+
+// Enabled reports whether capture is on.
+func Enabled() bool { return enabled }
+
+// Emit writes one record; fields keep insertion order for readability.
+func Emit(event string, fields ...any) {
+	if !enabled {
+		return
+	}
+	b := make([]byte, 0, 256)
+	b = append(b, `{"ev":`...)
+	b = strconv.AppendQuote(b, event)
+	b = append(b, `,"ns":`...)
+	b = strconv.AppendInt(b, time.Now().UnixNano(), 10)
+	for i := 0; i+1 < len(fields); i += 2 {
+		b = append(b, ',')
+		b = strconv.AppendQuote(b, fields[i].(string))
+		b = append(b, ':')
+		v, err := json.Marshal(fields[i+1])
+		if err != nil {
+			v = []byte(strconv.Quote(err.Error()))
+		}
+		b = append(b, v...)
+	}
+	b = append(b, '}', '\n')
+	mu.Lock()
+	_, _ = out.Write(b)
+	mu.Unlock()
+}
+
+// SetTask records the statement task ID now running on a connection.
+func SetTask(conn, task uint64) {
+	v, _ := tasks.LoadOrStore(conn, new(atomic.Uint64))
+	v.(*atomic.Uint64).Store(task)
+}
+
+// Task returns the statement task ID running on a connection.
+func Task(conn uint64) uint64 {
+	if v, ok := tasks.Load(conn); ok {
+		return v.(*atomic.Uint64).Load()
+	}
+	return 0
+}
+
+// Datums renders values as strings with NULL as null.
+func Datums(ds []types.Datum) []any {
+	r := make([]any, len(ds))
+	for i := range ds {
+		if ds[i].IsNull() {
+			continue
+		}
+		s, err := ds[i].ToString()
+		if err != nil {
+			s = "!" + err.Error()
+		}
+		r[i] = s
+	}
+	return r
+}
+
+// Hex renders a key.
+func Hex(k []byte) string { return hex.EncodeToString(k) }
+
+// Value renders a value: hex when short, otherwise its length.
+func Value(v []byte) any {
+	if len(v) <= 64 {
+		return hex.EncodeToString(v)
+	}
+	return map[string]int{"len": len(v)}
+}
+
+// Ranges renders key ranges as [lower, upper) hex pairs.
+func Ranges(rs []kv.KeyRange) [][2]string {
+	r := make([][2]string, len(rs))
+	for i, kr := range rs {
+		r[i] = [2]string{hex.EncodeToString(kr.StartKey), hex.EncodeToString(kr.EndKey)}
+	}
+	return r
+}
