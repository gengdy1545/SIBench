diff --git a/src/sibench_capture.rs b/src/sibench_capture.rs
new file mode 100644
index 000000000..d2d494668
--- /dev/null
+++ b/src/sibench_capture.rs
@@ -0,0 +1,209 @@
+// SIBench index-access capture: records the MVCC entries TiKV actually read for
+// coprocessor scans and point gets, one JSON line per request, when
+// SIBENCH_TIKV_CAPTURE names an output file. Disabled capture costs one
+// atomic load per hook and changes no read, lock or response behavior.
+
+use std::{
+    cell::{Cell, RefCell},
+    fs::{File, OpenOptions},
+    io::{BufWriter, Write},
+    sync::atomic::{AtomicBool, Ordering},
+    time::Instant,
+};
+
+use lazy_static::lazy_static;
+use parking_lot::Mutex;
+
+/// No version observed, a committed write's commit_ts, or a lock's start_ts
+/// for a value read through a committed (access) lock.
+pub const VERSION_NONE: u8 = 0;
+pub const VERSION_COMMIT: u8 = 1;
+pub const VERSION_LOCK: u8 = 2;
+
+struct Output {
+    writer: BufWriter<File>,
+    flushed: Instant,
+}
+
+lazy_static! {
+    static ref OUTPUT: Option<Mutex<Output>> = std::env::var("SIBENCH_TIKV_CAPTURE")
+        .ok()
+        .filter(|p| !p.is_empty())
+        .map(|path| {
+            let file = OpenOptions::new()
+                .create_new(true)
+                .append(true)
+                .open(&path)
+                .unwrap_or_else(|e| panic!("SIBENCH_TIKV_CAPTURE {}: {}", path, e));
+            Mutex::new(Output {
+                writer: BufWriter::with_capacity(1 << 20, file),
+                flushed: Instant::now(),
+            })
+        });
+    static ref ENABLED: AtomicBool = AtomicBool::new(OUTPUT.is_some());
+}
+
+thread_local! {
+    static VERSION: Cell<(u8, u64)> = const { Cell::new((VERSION_NONE, 0)) };
+    static POINTS: RefCell<Option<Vec<String>>> = const { RefCell::new(None) };
+}
+
+#[inline]
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// Called by the MVCC readers where they settle the version they return.
+#[inline]
+pub fn note_commit(ts: u64) {
+    VERSION.with(|v| v.set((VERSION_COMMIT, ts)));
+}
+
+#[inline]
+pub fn note_lock(start_ts: u64) {
+    VERSION.with(|v| v.set((VERSION_LOCK, start_ts)));
+}
+
+#[inline]
+pub fn reset_version() {
+    VERSION.with(|v| v.set((VERSION_NONE, 0)));
+}
+
+#[inline]
+pub fn take_version() -> (u8, u64) {
+    VERSION.with(|v| v.replace((VERSION_NONE, 0)))
+}
+
+/// Writes one complete line; flushed at least every 100 ms of activity.
+pub fn emit(line: &str) {
+    if let Some(output) = OUTPUT.as_ref() {
+        let mut out = output.lock();
+        out.writer.write_all(line.as_bytes()).unwrap();
+        out.writer.write_all(b"\n").unwrap();
+        if out.flushed.elapsed().as_millis() >= 100 {
+            out.writer.flush().unwrap();
+            out.flushed = Instant::now();
+        }
+    }
+}
+
+/// One read entry: key, value (hex when short), and the version it came from.
+pub fn entry_json(key: &[u8], value: Option<&[u8]>, version: (u8, u64)) -> String {
+    let value = match value {
+        None => "null".to_owned(),
+        Some(v) if v.len() <= 64 => format!("\"{}\"", hex::encode(v)),
+        Some(v) => format!("{{\"len\":{}}}", v.len()),
+    };
+    format!(
+        "{{\"k\":\"{}\",\"v\":{},\"vk\":{},\"vt\":{}}}",
+        hex::encode(key),
+        value,
+        version.0,
+        version.1
+    )
+}
+
+/// Collects batch-get entries on this thread between begin and finish.
+pub fn begin_points() {
+    POINTS.with(|p| *p.borrow_mut() = Some(Vec::new()));
+}
+
+pub fn push_point(entry: String) {
+    POINTS.with(|p| {
+        if let Some(points) = p.borrow_mut().as_mut() {
+            points.push(entry);
+        }
+    });
+}
+
+pub fn finish_points() -> Vec<String> {
+    POINTS.with(|p| p.borrow_mut().take().unwrap_or_default())
+}
+
+/// The request identity shared by every record of one RPC.
+pub fn request_json(
+    kind: &str,
+    ctx: &kvproto::kvrpcpb::Context,
+    start_ts: u64,
+) -> String {
+    format!(
+        "\"kind\":\"{}\",\"start_ts\":{},\"task_id\":{},\"region\":{},\"region_ver\":{},\"store\":{},\"source\":\"{}\",\"iso\":\"{:?}\",\"committed_locks\":{}",
+        kind,
+        start_ts,
+        ctx.get_task_id(),
+        ctx.get_region_id(),
+        ctx.get_region_epoch().get_version(),
+        ctx.get_peer().get_store_id(),
+        ctx.get_request_source().replace('"', "'"),
+        ctx.get_isolation_level(),
+        ctx.get_committed_locks().len()
+    )
+}
+
+/// The scans and point reads one coprocessor handler made through its storage.
+pub struct CopCapture {
+    pub header: String,
+    pub reads: Vec<String>,
+    current: Option<(String, Vec<String>)>,
+}
+
+impl CopCapture {
+    pub fn new(header: String) -> Self {
+        CopCapture {
+            header,
+            reads: Vec::new(),
+            current: None,
+        }
+    }
+
+    pub fn begin_scan(&mut self, lower: &[u8], upper: &[u8], desc: bool) {
+        self.close_scan(false);
+        self.current = Some((
+            format!(
+                "\"lo\":\"{}\",\"hi\":\"{}\",\"desc\":{}",
+                hex::encode(lower),
+                hex::encode(upper),
+                desc
+            ),
+            Vec::new(),
+        ));
+    }
+
+    pub fn scanned(&mut self, entry: Option<String>) {
+        match entry {
+            Some(e) => {
+                if let Some((_, entries)) = self.current.as_mut() {
+                    entries.push(e);
+                }
+            }
+            None => self.close_scan(true),
+        }
+    }
+
+    pub fn get(&mut self, entry: String) {
+        self.close_scan(false);
+        self.reads.push(format!("{{\"get\":{}}}", entry));
+    }
+
+    fn close_scan(&mut self, exhausted: bool) {
+        if let Some((range, entries)) = self.current.take() {
+            self.reads.push(format!(
+                "{{\"scan\":{{{},\"exhausted\":{},\"entries\":[{}]}}}}",
+                range,
+                exhausted,
+                entries.join(",")
+            ));
+        }
+    }
+}
+
+impl Drop for CopCapture {
+    fn drop(&mut self) {
+        self.close_scan(false);
+        emit(&format!(
+            "{{{},\"reads\":[{}]}}",
+            self.header,
+            self.reads.join(",")
+        ));
+    }
+}
