+    /**
+     * Checks the lease from one thread, as extendTransLease requires; it contacts the coordinator only
+     * when the lease is expiring. The first failure is recorded and ends the renewal.
+     */
+    private static ScheduledExecutorService renewLease(TransService transService, TransContext context,
+                                                       AtomicReference<Throwable> failure)
+    {
+        ScheduledExecutorService renewal = Executors.newSingleThreadScheduledExecutor(task -> {
+            Thread thread = new Thread(task, "load-lease-renewal-" + context.getTransId());
+            thread.setDaemon(true);
+            return thread;
+        });
+        long interval = Math.max(1000L, context.getLease().getPeriodMs() / 10);
+        renewal.scheduleWithFixedDelay(() -> {
+            try
+            {
+                if (!transService.extendTransLease(context))
+                {
+                    throw new TransException("LOAD transaction " + context.getTransId() + " lease has expired");
+                }
+            } catch (Throwable error)
+            {
+                failure.compareAndSet(null, error);
+                throw new IllegalStateException("LOAD lease renewal stopped", error);
+            }
+        }, interval, interval, TimeUnit.MILLISECONDS);
+        return renewal;
+    }
+
+    private static void stopRenewal(ScheduledExecutorService renewal) throws InterruptedException, TransException
+    {
+        renewal.shutdownNow();
+        if (!renewal.awaitTermination(60, TimeUnit.SECONDS))
+        {
+            throw new TransException("LOAD lease renewal did not stop before commit");
+        }
+    }
+
+    private static void requireLease(AtomicReference<Throwable> failure) throws TransException
+    {
+        Throwable error = failure.get();
+        if (error != null)
+        {
+            throw new TransException("LOAD transaction lease renewal failed", error);
+        }
+    }
