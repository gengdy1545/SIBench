diff --git a/src/main/java/io/pixelsdb/pixels/sink/SibenchReport.java b/src/main/java/io/pixelsdb/pixels/sink/SibenchReport.java
new file mode 100644
index 0000000..bbe1b71
--- /dev/null
+++ b/src/main/java/io/pixelsdb/pixels/sink/SibenchReport.java
@@ -0,0 +1,89 @@
+/*
+ * SIBench CDC generation support for pixels-sink; distributed under the pixels-sink license.
+ */
+package io.pixelsdb.pixels.sink;
+
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.OutputStreamWriter;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Reports the Pixels timestamp of every source transaction at BEGIN and after its successful
+ * commit to the SIBench generator. Any write, commit or rollback failure is reported and halts
+ * the process, so a stalled or partially applied transaction never looks complete.
+ */
+public final class SibenchReport
+{
+    private static final BufferedWriter OUTPUT = connect();
+
+    private SibenchReport() {}
+
+    private static BufferedWriter connect()
+    {
+        String endpoint = System.getProperty("sibench.report.endpoint"), token = System.getProperty("sibench.report.token");
+        try
+        {
+            if (endpoint == null || token == null) throw new IOException("Missing sibench.report.endpoint/token");
+            int colon = endpoint.lastIndexOf(':');
+            Socket socket = new Socket();
+            socket.connect(new InetSocketAddress(endpoint.substring(0, colon), Integer.parseInt(endpoint.substring(colon + 1))), 30_000);
+            socket.setTcpNoDelay(true);
+            BufferedWriter output = new BufferedWriter(new OutputStreamWriter(socket.getOutputStream(), StandardCharsets.UTF_8));
+            output.write("T " + token + "\n");
+            output.flush();
+            return output;
+        } catch (IOException | RuntimeException error)
+        {
+            System.err.println("SIBench report connection failed: " + error);
+            Runtime.getRuntime().halt(70);
+            throw new IllegalStateException(error);
+        }
+    }
+
+    public static void begin(long timestamp)
+    {
+        line("B " + timestamp);
+    }
+
+    public static void commit(long timestamp)
+    {
+        line("C " + timestamp);
+    }
+
+    public static void fail(String message, Throwable cause)
+    {
+        System.err.println("SIBench generation stops: " + message);
+        if (cause != null) cause.printStackTrace();
+        try
+        {
+            synchronized (OUTPUT)
+            {
+                OUTPUT.write("F " + message.replace('\n', ' ') + (cause == null ? "" : ": " + String.valueOf(cause).replace('\n', ' ')) + "\n");
+                OUTPUT.flush();
+            }
+        } catch (IOException ignored)
+        {
+            // The halt below still stops the generation; the connection loss is itself a failure signal.
+        }
+        Runtime.getRuntime().halt(70);
+    }
+
+    private static void line(String text)
+    {
+        try
+        {
+            synchronized (OUTPUT)
+            {
+                OUTPUT.write(text);
+                OUTPUT.write('\n');
+                OUTPUT.flush();
+            }
+        } catch (IOException error)
+        {
+            fail("SIBench report connection lost", error);
+        }
+    }
+}
